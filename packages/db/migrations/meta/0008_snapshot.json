      "checkConstraints": {
        "ai_analyses_mode_gate": {
          "name": "ai_analyses_mode_gate",
          "value": "(\"ai_analyses\".\"mode\" = 'analysis' AND \"ai_analyses\".\"gate_state\" = 'PAIN_POINT_ANALYSIS') OR (\"ai_analyses\".\"mode\" = 'discovery' AND \"ai_analyses\".\"gate_state\" = 'PROFILE_DISCOVERY')"
        },
        "ai_analyses_status": {
          "name": "ai_analyses_status",
          "value": "\"ai_analyses\".\"status\" IN ('ACCEPTED', 'REJECTED')"
        },
        "ai_analyses_provider": {
          "name": "ai_analyses_provider",
          "value": "\"ai_analyses\".\"provider\" IN ('MOCK', 'OPENCODE_GO', 'CHATGPT_WEB')"
        },
        "ai_analyses_reasoning": {
          "name": "ai_analyses_reasoning",
          "value": "\"ai_analyses\".\"reasoning\" IS NULL OR \"ai_analyses\".\"reasoning\" IN ('DEFAULT', 'LOW', 'MEDIUM', 'HIGH')"
        },
        "ai_analyses_no_model": {
          "name": "ai_analyses_no_model",
          "value": "\"ai_analyses\".\"provider\" NOT IN ('MOCK', 'CHATGPT_WEB') OR (\"ai_analyses\".\"model\" IS NULL AND \"ai_analyses\".\"reasoning\" IS NULL AND \"ai_analyses\".\"prompt_tokens\" IS NULL AND \"ai_analyses\".\"completion_tokens\" IS NULL)"
        },
        "ai_analyses_model": {
          "name": "ai_analyses_model",
          "value": "\"ai_analyses\".\"provider\" IN ('MOCK', 'CHATGPT_WEB') OR (\"ai_analyses\".\"model\" IS NOT NULL AND \"ai_analyses\".\"reasoning\" IS NOT NULL)"
        },
        "ai_analyses_attempts": {
          "name": "ai_analyses_attempts",
          "value": "\"ai_analyses\".\"attempts\" IN (1, 2)"
        },
        "ai_analyses_tokens": {
          "name": "ai_analyses_tokens",
          "value": "(\"ai_analyses\".\"prompt_tokens\" IS NULL OR \"ai_analyses\".\"prompt_tokens\" >= 0) AND (\"ai_analyses\".\"completion_tokens\" IS NULL OR \"ai_analyses\".\"completion_tokens\" >= 0)"
        },
        "ai_analyses_outcome": {
          "name": "ai_analyses_outcome",
          "value": "(\"ai_analyses\".\"status\" = 'ACCEPTED' AND \"ai_analyses\".\"output_json\" IS NOT NULL AND \"ai_analyses\".\"raw_output\" IS NULL) OR (\"ai_analyses\".\"status\" = 'REJECTED' AND coalesce(length(\"ai_analyses\".\"raw_output\"), 0) BETWEEN 1 AND 20000)"
        }
      }
    },
